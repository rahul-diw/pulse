PORT=4000
MONGO_URI=                 # empty = in-memory demo DB. Production: your MongoDB Atlas URI
JWT_SECRET=change-me-to-a-long-random-string
AI_URL=http://localhost:8000
CORS_ORIGIN=*              # production: your frontend URL (ingest works from any origin because it uses an API key)
SEED_DEMO=true             # false in production
# frontend (Vercel): VITE_API_URL=https://<api>.onrender.com/api   VITE_WS_URL=https://<api>.onrender.com
